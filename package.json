{
  "name": "a11y-check",
  "version": "1.1.2",
  "description": "PDF accessibility pre-flight for CI: heuristic and bounded, not PDF/UA certification.",
  "type": "module",
  "bin": {
    "a11y-check": "a11y-check.mjs"
  },
  "scripts": {
    "test": "node --test a11y-check.test.mjs",
    "verify": "node --check a11y-check.mjs && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "keywords": [
    "pdf",
    "accessibility",
    "pdf-ua",
    "a11y",
    "ci"
  ],
  "license": "MIT",
  "files": [
    "a11y-check.mjs",
    "examples/",
    "demo/",
    "SECURITY.md",
    "LICENSE"
  ]
}
